<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" /> <!-- SOFTM-ADMOB-ADID 날짜:20261012 : Play 광고 ID 선언과 AdMob 광고 요청 권한을 일치 -->
    <application android:enableOnBackInvokedCallback="false" android:label="@string/app_name" android:icon="@drawable/ic_launcher" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="@string/admob_app_id" /> <!-- SOFTM-ADMOB-NATIVE 날짜:20261010 : AdMob SDK 초기화에 필요한 앱 ID를 리소스로 분리 -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- SOFTM-MEMBERS 날짜:20261120 : 검증된 공식 도메인의 로그인 콜백만 기존 WebView 작업으로 복귀 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="homecare.designboard.net" android:path="/auth-callback.html" />
            </intent-filter>
        </activity>
    </application>
</manifest>
