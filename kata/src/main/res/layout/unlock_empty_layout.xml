<?xml version="1.0" encoding="utf-8"?>
<net.softm.data.kata.ACSFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_margin="0dp"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:id="@+id/lnOverlay"
    android:background="@color/Wheat"

    >
<!--    android:background="@color/transparent"-->

<!--<net.softm.data.kata.ACSFrameLayout.ACSFrameLayout-->
<!--     android:layout_height="100dp" android:layout_width="100dp"/>-->
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="50dp"
        android:paddingRight="50dp"
        android:layout_gravity="center"
        android:layout_marginTop="-120dp"
        />


<!--    <LinearLayout-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:paddingLeft="0dp"-->
<!--        android:paddingRight="0dp"-->
<!--        android:layout_gravity="center"-->
<!--        android:layout_marginBottom="100dp"-->
<!--        >-->


<!--    </LinearLayout>-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="50dp"
        android:paddingRight="50dp"
        android:layout_gravity="center"
        android:layout_marginBottom="85dp"
        >

        <TextView
            android:id="@+id/my_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:singleLine="false"
            android:text="@string/app_name_short"
            android:textColor="@color/mainTextColor"
            android:textSize="@dimen/fontSize22"
            android:textStyle="normal"
            android:paddingRight="5dp"/>
<!--            android:background="#ffffff"-->


        <!--            android:background="#ffffff"-->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="100dp"
        android:paddingRight="100dp"
        android:layout_gravity="center"
        android:layout_marginBottom="-40dp"

        >

        <TextView
            android:id="@+id/app_name"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:paddingLeft="10dp"
            android:singleLine="false"
            android:text="@string/app_name"
            android:textColor="@color/brown_900"
            android:textSize="@dimen/fontSize15"
            android:textStyle="normal" />
        <!--            android:background="#ffffff"-->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="100dp"
        android:paddingRight="100dp"
        android:layout_gravity="center"
        android:layout_marginBottom="-60dp"
        />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:layout_gravity="center"
        android:layout_marginBottom="-95dp"
        />

    <com.skyfishjy.library.RippleBackground
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="35dp"
        android:gravity="center_vertical|center_horizontal"
        app:rb_color="#0099CC"
        app:rb_duration="3000"
        app:rb_radius="20dp"
        app:rb_rippleAmount="4"
        app:rb_scale="6">

        <ImageView
            android:id="@+id/app_logo_"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:src="@drawable/logo" />

    </com.skyfishjy.library.RippleBackground>


</net.softm.data.kata.ACSFrameLayout>