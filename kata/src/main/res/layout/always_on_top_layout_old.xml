<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_margin="0dp"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:background="#1f3442">
<!--    android:background="#1f3442"-->
<!--    android:background="#F7CDB7"-->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        >

        <TextView
            android:id="@+id/txtAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="___________________"
            android:textColor="#f1c40f"
            android:textStyle="bold"
            android:layout_marginTop="3dp"
            android:textSize="@dimen/guide_text_font_size"
            android:singleLine="false"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            >
            <Button
                android:id="@+id/btnSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_gomain"
                android:background="@drawable/chip_green"
                android:enabled="true"
                android:textColor="#FFFFFF"
                android:minHeight="30dp"
                android:minWidth="90dp"
                android:textSize="@dimen/overlay_top_button_font_size"
                android:textStyle="bold"
                android:gravity="center"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        android:id="@+id/lnGuide"
        android:visibility="gone"
        >
        <TextView
            android:id="@+id/txtGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_guide_5"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:layout_marginTop="3dp"
            android:layout_marginRight="10dp"
            android:textSize="@dimen/guide_text_font_size"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_margin="0dp"
        android:padding="0dp"
        >

        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:background="@drawable/button_default"
            android:enabled="true"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:text="@string/guide_start"
            android:textColor="#ffffff"
            android:textSize="@dimen/guide_button_font_size"
            android:textStyle="bold"
            android:gravity="center_vertical"
            />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_close"
            android:background="@drawable/button_gray"
            android:enabled="true"
            android:textColor="#000000"
            android:minHeight="40dp"
            android:minWidth="40dp"
            android:textSize="@dimen/guide_button_font_size"
            android:layout_gravity="right"
            android:layout_marginLeft="10dp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            />

    </LinearLayout>


        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        android:layout_marginBottom="5dp"
        android:visibility="gone"
        >

        <Button
            android:id="@+id/btnCloseHour"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:background="@drawable/chip_default"
            android:enabled="true"
            android:gravity="center_vertical"
            android:minWidth="220dp"
            android:minHeight="40dp"
            android:text="@string/guide_donot_navi_hour"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/guide_button_font_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        >

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:visibility="visible"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
        >
        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home"
            android:background="@drawable/chip_pink"
            android:enabled="true"
            android:textColor="#FFFFFF"
            android:minHeight="30dp"
            android:minWidth="90dp"
            android:textSize="@dimen/overlay_top_button_font_size"
            android:textStyle="normal"
            android:gravity="center"
            />
        <Button
            android:id="@+id/btnCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/company"
            android:background="@drawable/chip_yellowgreen"
            android:enabled="true"
            android:textColor="#FFFFFF"
            android:minHeight="30dp"
            android:minWidth="90dp"
            android:textSize="@dimen/overlay_top_button_font_size"
            android:textStyle="normal"
            android:gravity="center"
            android:layout_marginLeft="10dp"
            />
        <Button
            android:id="@+id/btnStartNavi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/destination"
            android:background="@drawable/chip_skyblue"
            android:enabled="true"
            android:textColor="#FFFFFF"
            android:minHeight="30dp"
            android:minWidth="90dp"
            android:textSize="@dimen/overlay_top_button_font_size"
            android:textStyle="normal"
            android:gravity="center"
            android:layout_marginLeft="10dp"
            />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:paddingBottom="5dp"
        android:visibility="visible"
        android:id="@+id/lnChip"
        >
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"/>

        <!--    android:background="#F7CDB7"-->
        <com.adroitandroid.chipcloud.ChipCloud
            android:id="@+id/chip_cloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="0dp"
            android:layout_marginTop="10dp"
            >
        </com.adroitandroid.chipcloud.ChipCloud>
    </LinearLayout>
