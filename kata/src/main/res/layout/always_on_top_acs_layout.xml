<?xml version="1.0" encoding="utf-8"?>
<net.softm.data.kata.ACSFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lnOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="0dp"
    android:background="@color/Wheat"
    android:backgroundTint="#F5DEB3"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="0dp"
    android:paddingRight="0dp">

    <ImageView
        android:layout_width="50sp"
        android:layout_height="50sp"
        android:layout_gravity="top|right"
        android:src="@drawable/vip"
        android:id="@+id/imgVip"
        android:scaleType="fitXY"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:background="@color/transparent"
        android:visibility="gone"

        />
    <LinearLayout
        android:id="@+id/lnAvdTwinkle"
        android:background="@color/orange_200"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:visibility="gone">
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ad_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingRight="10dp"
            android:singleLine="false"
            android:text="Banner"
            android:textColor="@color/mainTextColor"
            android:textSize="@dimen/fontSize20"
            android:textStyle="normal" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible"
        android:id="@+id/lnAvdMain"
        >
        <LinearLayout
            android:id="@+id/lnAvdMsgArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12"
            android:visibility="visible"
            android:orientation="vertical"
            android:layout_marginTop="15dp"
            >
            <!--            android:textColor="@color/brown_900"-->

            <!--            android:text="@string/msg_adview_user_earned_reward"-->
            <!--            android:textColor="@color/red_500"-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.7"
                android:visibility="visible"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                >
                <TextView
                    android:id="@+id/tvAvdMsg"
                    android:layout_height="match_parent"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_gravity="top"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:layout_marginTop="5sp"
                    android:layout_marginBottom="5sp"
                    android:paddingLeft="10sp"
                    android:paddingRight="10sp"
                    android:paddingVertical="4dp"
                    android:singleLine="false"
                    android:text="@string/msg_adview_if"
                    android:textColor="@color/red_600"
                    android:textSize="@dimen/fontSize20"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="2sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvAvdMsg2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.4"
                android:layout_gravity="top"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingRight="10sp"
                android:singleLine="false"
                android:text="@string/msg_adview_recuce_waittime"
                android:textColor="@color/black_200"
                android:textSize="@dimen/fontSize20"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="2sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lnAvd"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.08"
            android:layout_gravity="top"
            android:background="@color/orange_200"
            android:paddingLeft="20sp"
            android:layout_marginTop="5sp"
            android:paddingTop="5sp"
            android:paddingRight="20sp"
            android:paddingBottom="5sp"
            >
            <!--        android:padding="10dp"-->

            <!--            android:autoSizeMinTextSize="10sp"-->
            <!--            android:autoSizeMaxTextSize="35sp"-->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_weight="0.08"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_weight="0.4"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingRight="5sp"
                android:paddingVertical="0sp"
                android:layout_marginTop="5sp"
                android:layout_marginBottom="5sp"
                android:paddingHorizontal="37dp"
                android:singleLine="false"
                android:text="@string/msg_get_rewarded"
                android:textColor="@color/brown_900"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="2sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/btnAvd"
                android:background="@drawable/chip_pink"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_weight="0.4"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingRight="30sp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="35dp"
                android:singleLine="false"
                android:text="@string/msg_adview_watching_ads"
                android:textColor="@color/white"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="2sp"
                android:textStyle="bold"
                android:visibility="visible"
                android:layout_marginTop="5sp"
                android:layout_marginBottom="5sp"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_weight="0.08"
                />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="-120dp"
        android:gravity="center_horizontal"
        android:paddingLeft="50dp"
        android:paddingRight="50dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/receiver_status"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:gravity="left|bottom"
            android:maxLines="2"
            android:paddingLeft="5dp"
            android:singleLine="false"
            android:text="Power"
            android:textColor="@color/black"
            android:textSize="@dimen/fontSize10"
            android:textStyle="bold" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="85dp"
        android:paddingLeft="50dp"
        android:paddingRight="50dp">

        <TextView
            android:id="@+id/my_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center|right"
            android:layout_gravity="center_vertical"
            android:maxLines="2"
            android:paddingRight="5dp"
            android:singleLine="false"
            android:text="@string/app_name"
            android:textColor="@color/mainTextColor"
            android:textSize="@dimen/fontSize12"
            android:textStyle="bold" />
        <!--            android:background="#ffffff"-->

        <TextView
            android:id="@+id/statu2"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="left"
            android:maxLines="2"
            android:paddingLeft="5dp"
            android:singleLine="false"
            android:text="종료"
            android:textColor="@color/red_500"
            android:textSize="@dimen/fontSize22"
            android:textStyle="bold" />


        <!--            android:background="#ffffff"-->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="-40dp"
        android:paddingLeft="100dp"
        android:paddingRight="100dp"

        >

        <TextView
            android:id="@+id/app_name"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:paddingLeft="10dp"
            android:singleLine="false"
            android:text="@string/app_name"
            android:textColor="@color/brown_900"
            android:textSize="@dimen/fontSize15"
            android:textStyle="normal" />
        <!--            android:background="#ffffff"-->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="-60dp"
        android:paddingLeft="100dp"
        android:paddingRight="100dp"
        >

        <TextView
            android:id="@+id/statu22"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="0.5"
            android:ellipsize="end"
            android:gravity="right"
            android:maxLines="2"
            android:paddingLeft="5dp"
            android:singleLine="false"
            android:text="종료"
            android:textColor="#F44336"
            android:textSize="@dimen/fontSize22"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/info_time_sec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingRight="5dp"
            android:singleLine="false"
            android:text="5"
            android:textColor="@color/red"
            android:textSize="@dimen/fontSize22"
            android:textStyle="bold" />
        <!--            android:background="#ffffff"-->

        <TextView
            android:id="@+id/status3"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="0.5"
            android:ellipsize="end"
            android:gravity="left"
            android:maxLines="2"
            android:paddingLeft="10dp"
            android:singleLine="false"
            android:text="@string/sec"
            android:textColor="@color/mainTextColor"
            android:textSize="@dimen/fontSize22"
            android:textStyle="bold" />
        <!--            android:background="#ffffff"-->
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:visibility="visible"
            >

            <com.skyfishjy.library.RippleBackground
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="35dp"
                android:gravity="center_vertical|center_horizontal"
                app:rb_color="#0099CC"
                app:rb_duration="5000"
                app:rb_radius="20dp"
                app:rb_rippleAmount="3"
                app:rb_scale="6">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="test"
                    android:gravity="right"
                    android:paddingRight="10dp"
                    android:id="@+id/tvOrientation"
                >
                </TextView>
                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:src="@drawable/logo_white" />
                <Button
                    android:id="@+id/btnContinue"
                    android:layout_width="95dp"
                    android:layout_height="90dp"
                    android:background="@drawable/chip_ripple"
                    android:text="계속"
                    android:textStyle="bold"
                    android:textColor="#FFF"
                    android:textSize="@dimen/fontSize23"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    ></Button>
            </com.skyfishjy.library.RippleBackground>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="-105dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">
        <!--        android:layout_width="match_parent"-->
        <!--        android:layout_height="wrap_content"-->
        <!--        android:layout_marginBottom="100dp"-->
        <!--        android:layout_gravity="bottom"-->
        <Button
            android:id="@+id/btnExecStop"
            android:background="@color/wheat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:text="@string/stops_touch"
            android:textColor="@color/brown_900"
            android:textSize="@dimen/fontSize22"
            android:textStyle="bold" />
    </LinearLayout>

    <!--        android:layout_weight="0.1"-->


</net.softm.data.kata.ACSFrameLayout>