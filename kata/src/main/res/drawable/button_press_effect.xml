<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" >
        <shape>
            <solid android:color="#e0e0e0"/>
            <stroke android:width="1dip" android:color="#e0e0e0" />
        </shape>
    </item><!-- diabled -->
    <item android:state_pressed="false" >
        <shape>
            <solid android:color="@color/transparent" />
            <stroke android:width="1dip" android:color="#05000000" />
            <corners android:radius="20dip"/>
        </shape>
    </item><!-- pressed : basic -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E3CAC9"/>
            <stroke android:width="1dip" android:color="#E3CAC9" />
        </shape>
    </item><!-- focused : over -->
    <item android:state_enabled="true">
        <shape>
            <solid android:color="#D77976"/>
            <stroke android:width="1dip" android:color="#D77976" />
        </shape>
    </item><!-- idle state : basic -->
</selector>
