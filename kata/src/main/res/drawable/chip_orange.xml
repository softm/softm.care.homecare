<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" >
        <shape>
            <solid android:color="#e0e0e0"/>
            <stroke android:width="1dip" android:color="#e0e0e0" />
            <corners android:radius="50dip"/>
            <padding android:left="17dp" android:top="0dp" android:right="17dp" android:bottom="0dp" />
        </shape>
    </item><!-- diabled -->
    <item android:state_pressed="false" >
        <shape>
            <solid android:color="#f39c12"/>
            <stroke android:width="1dip" android:color="#f39c12" />
            <corners android:radius="50dip"/>
            <padding android:left="17dp" android:top="0dp" android:right="17dp" android:bottom="0dp" />
        </shape>
    </item><!-- pressed : basic -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#edc8a8"/>
            <stroke android:width="1dip" android:color="#edc8a8" />
            <corners android:radius="50dip"/>
            <padding android:left="17dp" android:top="0dp" android:right="17dp" android:bottom="0dp" />
        </shape>
    </item><!-- focused : over -->
    <item android:state_enabled="true">
        <shape>
            <solid android:color="#f39c12"/>
            <stroke android:width="1dip" android:color="#f39c12" />
            <corners android:radius="50dip"/>
            <padding android:left="17dp" android:top="0dp" android:right="17dp" android:bottom="0dp" />
        </shape>
    </item><!-- idle state : basic -->
</selector>
