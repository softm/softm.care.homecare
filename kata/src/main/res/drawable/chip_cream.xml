<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" >
        <shape>
            <solid android:color="#e0e0e0"/>
            <stroke android:width="1dip" android:color="#e0e0e0" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- diabled -->
    <item android:state_pressed="false" >
        <shape>
            <solid android:color="#F7CDB7"/>
            <stroke android:width="1dip" android:color="#F7CDB7" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- pressed : basic -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#F8D7C6"/>
            <stroke android:width="1dip" android:color="#F8D7C6" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- focused : over -->
    <item android:state_enabled="true">
        <shape>
            <solid android:color="#F7CDB7"/>
            <stroke android:width="1dip" android:color="#F7CDB7" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- idle state : basic -->
</selector>
