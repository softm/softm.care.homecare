<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/ic_overlay_home_24">
        <shape>
            <solid android:color="#e0e0e0"/>
            <stroke android:width="1dip" android:color="#e0e0e0" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- diabled -->
    <item android:state_pressed="false" android:drawable="@drawable/ic_overlay_home_24">
        <shape>
            <solid android:color="#D77976"/>
            <stroke android:width="1dip" android:color="#D77976" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- pressed : basic -->
    <item android:state_pressed="true" android:drawable="@drawable/ic_overlay_home_24">
        <shape>
            <solid android:color="#E3CAC9"/>
            <stroke android:width="1dip" android:color="#E3CAC9" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- focused : over -->
    <item android:state_enabled="true" android:drawable="@drawable/ic_overlay_home_24">
        <shape>
            <solid android:color="#D77976"/>
            <stroke android:width="1dip" android:color="#D77976" />
            <corners android:radius="50dip"/>

        </shape>
    </item><!-- idle state : basic -->
</selector>
